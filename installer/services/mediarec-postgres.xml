<!--
  WinSW: mediarec-postgres
  Docs: docs/packaging/windows-services.md

  Install-time substitutions:
    __PROGRAMDATA__  -> e.g. C:\ProgramData\MediaRecommendationEngine
  Place mediarec-postgres.exe (WinSW-x64 copy) beside this XML under runtime\winsw\.
  Cluster must already exist (Initialize-MediaRecDatabase.ps1).
-->
<service>
  <id>mediarec-postgres</id>
  <name>Media Recommendation Engine PostgreSQL</name>
  <description>Bundled PostgreSQL 16 for Media Recommendation Engine.</description>
  <executable>%BASE%\..\postgres\bin\postgres.exe</executable>
  <arguments>-D "__PROGRAMDATA__\postgres\data"</arguments>
  <workingdirectory>%BASE%\..\postgres\bin</workingdirectory>
  <logpath>__PROGRAMDATA__\logs\mediarec-postgres</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
  <!-- LocalSystem is rejected by PostgreSQL on Windows ("administrative permissions").
       <allowservicelogon> grants the account the "Log on as a service" right so a bare
       `winsw install` sets the account without falling back to LocalSystem. The install
       scripts still WMI-switch + verify + health-gate as the real guarantee. -->
  <serviceaccount>
    <username>NT AUTHORITY\LocalService</username>
    <allowservicelogon>true</allowservicelogon>
  </serviceaccount>
  <onfailure action="restart" delay="5 sec"/>
  <onfailure action="restart" delay="10 sec"/>
  <!-- Do not use action="reboot": ChangeServiceConfig2 requires SeShutdownPrivilege
       and fails install with "Failed to configure the failure actions. Access is denied."
       on many admin sessions; a media app must not reboot the machine. -->
  <resetfailure>1 hour</resetfailure>
  <startmode>Automatic</startmode>
  <delayedAutoStart>false</delayedAutoStart>
  <stoptimeout>30 sec</stoptimeout>
</service>
