# Database
# NOTE: these are local-dev defaults. CHANGE both the Postgres and Redis passwords (and
# the matching *_URL values) for any deployment reachable beyond loopback.
POSTGRES_USER=mediarec
POSTGRES_PASSWORD=mediarec
POSTGRES_DB=mediarec
DATABASE_URL=postgresql+psycopg://mediarec:mediarec@localhost:5432/mediarec

# Redis (requirepass; compose injects this into REDIS_URL for containers)
REDIS_PASSWORD=mediarec-redis
REDIS_URL=redis://:mediarec-redis@localhost:6379/0

# API
# REQUIRED. The app refuses to start on this placeholder or any key < 32 chars.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_SECRET_KEY=change-me-in-production-use-long-random-string
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ACCESS_TOKEN_EXPIRE_MINUTES=720
# REQUIRED to store import-source credentials (independent of API_SECRET_KEY).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_FERNET_KEY=
# Comma-separated previous Fernet keys, kept only for decryption during key rotation.
CREDENTIALS_FERNET_KEYS_OLD=
# Run imports inline when the RQ worker is down (local dev only; never in production).
ALLOW_INLINE_IMPORT_SYNC=false
# Local-first: allow RFC1918/loopback for Plex/Jellyfin import base_urls (metadata still blocked).
ALLOW_PRIVATE_IMPORT_URLS=true
# Set false after first-user setup to disable open registration.
REGISTRATION_ENABLED=true
# When true, rate-limiter backend errors allow the request (dev only). Default fail-closed.
RATE_LIMIT_FAIL_OPEN=false
LOGIN_RATE_LIMIT_PER_MINUTE=10
LOGIN_RATE_LIMIT_PER_USERNAME_PER_MINUTE=5
REGISTER_RATE_LIMIT_PER_HOUR=20
# Per-user cap on expensive feed (re)generation.
FEED_RATE_LIMIT_PER_MINUTE=30
# Cap on how many of a user's most-recent interactions are folded into their taste
# profile per feed generation (bounds latency for long-lived accounts).
PROFILE_MAX_INTERACTIONS=5000
# Prune RecommendationEvent rows for a (user, feed) older than this on each generation
# so the table can't grow unbounded. Offline metrics read these rows; 0 disables pruning.
RECOMMENDATION_EVENT_RETENTION_DAYS=90
TRUST_PROXY_HEADERS=false
# When true, seed failures do not block API startup (dev only).
SEED_FAIL_SOFT=false
# Seconds between collaborative-filter rebuild enqueues (default 24h).
CF_REBUILD_INTERVAL_SECONDS=86400
# Native Windows packaging only: Vite dist directory served by FastAPI (empty = API-only).
# WEB_DIST_DIR=

# Ollama (optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
ENRICHMENT_ENABLED=false
# Optional: TMDB API key for movie/TV posters and TMDB catalog harvest import source.
# Ranking never depends on this. https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Frontend
# Where the SPA sends API calls. Keep this pointing at the API origin when the web app is
# served separately (Vite dev server on :5173, or Docker nginx). For the native Windows
# build the API serves the SPA itself, so leave this UNSET (commented out) to use a
# same-origin relative base — an explicit http://localhost:8000 there breaks same-origin.
# Uncomment ONLY when serving the web app on a different origin than the API:
# VITE_API_BASE_URL=http://localhost:8000
