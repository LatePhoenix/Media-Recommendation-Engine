# Database
POSTGRES_USER=mediarec
POSTGRES_PASSWORD=mediarec
POSTGRES_DB=mediarec
DATABASE_URL=postgresql+psycopg://mediarec:mediarec@localhost:5432/mediarec

# Redis
REDIS_URL=redis://localhost:6379/0

# API
# REQUIRED. The app refuses to start on this placeholder or any key < 32 chars.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_SECRET_KEY=change-me-in-production-use-long-random-string
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ACCESS_TOKEN_EXPIRE_MINUTES=720
# REQUIRED to store import-source credentials (independent of API_SECRET_KEY).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_FERNET_KEY=
# Comma-separated previous Fernet keys, kept only for decryption during key rotation.
CREDENTIALS_FERNET_KEYS_OLD=
# Run imports inline when the RQ worker is down (local dev only; never in production).
ALLOW_INLINE_IMPORT_SYNC=false

# Ollama (optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
ENRICHMENT_ENABLED=false

# Frontend
VITE_API_BASE_URL=http://localhost:8000
